#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = []
# ///
import functools
import json
import re
import subprocess
import sys
from pathlib import Path
from urllib.request import urlopen

CONFIG = "/etc/px.conf"
CADDY = "/etc/caddy/conf.d/pretalx.conf"
SOCKET = "/run/gunicorn/pretalx_{}"
PYTHON_VERSION = f"{sys.version_info.major}.{sys.version_info.minor}"


def print_help():
    message = """px is a pretalx helper tool, made for pretalx.com

Usage:
  px status      Show information on the currently active pretalx
  px restart     Restart the currently active pretalx
  px start       Start the currently active pretalx
  px stop        Stop the currently active pretalx
  px run         Run a command with the current pretalx, e.g. px run shell_scoped --override
  px celery      Run a celery command with the current pretalx, e.g. px celery events, or px celery inspect [active/scheduled]
  px update      Update to a given git ref, or main, if none was given.
       --no-plugins  Skips plugin updates
       --skip-rebuild  Skips the rebuild step
  px init        Install all configured plugins
       --system  Install all configured plugins and pretalx itself
  px autoupdate  Update plugins, then update core if a newer commit has a passing build
       --no-plugins  Skips plugin updates
       --skip-rebuild  Skips the rebuild step
"""
    print(message)


def subprocess_run(commands, **kwargs):
    command = " ".join(commands)
    if location := kwargs.get("cwd"):
        location = f" in {location}"
    location = location or ""
    print(f"Running command{location}:\n    {command}", flush=True)
    return subprocess.run(commands, **kwargs)


def get_config():
    try:
        with open(CONFIG, "r") as f:
            config = json.load(f)
    except Exception:
        config = None
    if not config:
        config = {
            "user": "pretalx",
            "venvs": ["green", "blue"],
            "current": "green",
            "version": None,
            "plugins": [
                {
                    "name": "pretalx-com",
                    "repository": "git@github.com:rixx/pretalx-com.git",
                },
                {
                    "name": "pretalx-downstream",
                    "repository": "git@github.com:pretalx/pretalx-downstream.git",
                },
                {
                    "name": "pretalx-media-ccc-de",
                    "repository": "git@github.com:pretalx/pretalx-media-ccc-de.git",
                },
            ],
        }
        save_config(config=config)
    return config


def save_config(*, config):
    with open(CONFIG, "w") as f:
        json.dump(config, f, indent=4)


def format_value(value):
    if isinstance(value, list):
        return ", ".join([format_value(v) for v in value])
    if isinstance(value, dict):
        return ", ".join([f"{k}: {format_value(v)}" for k, v in value.items()])
    return str(value)


def status(*, args):
    print("========== Current config ==========")
    config = get_config()
    for key, value in config.items():
        print(f"{key}: {format_value(value)}")
    print("========== Current status ==========")
    systemd_pretalx("status")


def systemd_run(action, service, cwd=None):
    return subprocess_run(["sudo", "systemctl", action, service], check=True, cwd=cwd)


def systemd_pretalx(command, *, args=None):
    config = get_config()
    current_venv = config["current"]
    systemd_run(command, f"pretalx@{current_venv}.service")
    systemd_run(command, f"pretalx-worker@{current_venv}.service")


def _run_venv_command(args, env=None, config=None, chdir=True):
    config = config or get_config()
    if not env:
        env = config.get("current")
    if not env:
        raise Exception("Can't determine venv to run command in.")
    user = config["user"]
    path = f"/var/lib/{user}/{env}/bin/python"
    chdir = f"/var/lib/{user}/" if chdir else None
    subprocess_run([path, *args], check=True, cwd=chdir)


def pretalx_run(*, args, **kwargs):
    return _run_venv_command(args=["-m", "pretalx", *args], **kwargs)


def celery_run(*, args, **kwargs):
    return _run_venv_command(args=["-m", "celery", *args], **kwargs)


def sha_equal(a, b):
    return a[:7] == b[:7]


def get_current_commit(config=None):
    config = config or get_config()
    user = config["user"]
    current = config["current"]
    for path in Path(f"/var/lib/{user}/{current}/lib").glob(
        "python*/site-packages/pretalx-*.dist-info/direct_url.json"
    ):
        try:
            with open(path) as f:
                return json.load(f)["vcs_info"]["commit_id"]
        except Exception:
            pass
    return config["version"]


def github_api(url):
    response = urlopen(url)
    if response.status != 200:
        raise Exception(f"GitHub returned status {response.status}")
    return json.loads(response.read().decode())


def git_head(path):
    try:
        result = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            cwd=path,
            capture_output=True,
            text=True,
            check=True,
        )
        return result.stdout.strip()
    except Exception:
        return None


def pull_plugins(config):
    cwd = f"/var/lib/{config['user']}"
    changed = []
    for plugin in config.get("plugins", []):
        plugin_path = f"{cwd}/plugins/{plugin['name']}"
        if not Path(plugin_path).exists():
            print(f"WARNING: {plugin['name']} has no checkout at {plugin_path}, skipping. Run px init.")
            continue
        before = git_head(plugin_path)
        subprocess_run(
            [
                "git",
                "pull",
                # always use upstream and discard local changes
                "--force",
            ],
            cwd=plugin_path,
            check=True,
        )
        if git_head(plugin_path) != before:
            changed.append(plugin["name"])
    return changed


def apply_plugin_changes(config, changed, skip_rebuild=False):
    print(f"Plugins changed ({', '.join(changed)}), applying to the running venv …")
    current_venv = config["current"]
    pretalx_run(args=["migrate"], env=current_venv, config=config)
    if not skip_rebuild:
        pretalx_run(args=["rebuild", "--silent"], env=current_venv, config=config)
    systemd_pretalx("restart")


def autoupdate(*, args):
    config = get_config()
    skip_rebuild = "--skip-rebuild" in args
    plugins_changed = []
    if "--no-plugins" in args:
        print("Skipping plugin updates")
    else:
        print("Updating plugins …")
        plugins_changed = pull_plugins(config)

    args = list(set(args) | {"--no-plugins"})

    def done():
        if plugins_changed:
            apply_plugin_changes(config, plugins_changed, skip_rebuild=skip_rebuild)

    # Check which commit we are running. If there is a new one that has a passing build, call update().
    current_commit = get_current_commit(config)

    # We're getting the latest 10 runs of pretalx tests
    try:
        data = github_api(
            "https://api.github.com/repos/pretalx/pretalx/actions/workflows/2006620/runs?per_page=10&branch=main&status=success"
        )
    except Exception as e:
        print(f"Could not fetch status from GitHub: {e}")
        return done()

    # The runs list is ordered by run creation, not commit date, so a re-run
    # of an old commit lists first. Sort by commit date and only deploy
    # commits that are ancestry-wise ahead of the current one.
    runs = [
        run
        for run in data["workflow_runs"]
        if run["status"] == "completed" and run["conclusion"] == "success"
    ]
    runs.sort(
        key=lambda run: (run.get("head_commit") or {}).get("timestamp", ""),
        reverse=True,
    )

    if not current_commit or not re.fullmatch(r"[0-9a-f]{7,40}", current_commit):
        # No usable current commit to compare against; trust the commit-date
        # ordering and take the newest passing run.
        if runs:
            run_commit = runs[0]["head_sha"]
            print(
                f"Current commit unknown ({current_commit!r}), "
                f"updating to newest passing commit {run_commit} …"
            )
            return update(args=[run_commit] + args)
        print("No commit with passing build found.")
        return done()

    for run in runs:
        run_commit = run["head_sha"]
        if sha_equal(run_commit, current_commit):
            # Already running the newest passing commit.
            return done()
        try:
            comparison = github_api(
                f"https://api.github.com/repos/pretalx/pretalx/compare/{current_commit}...{run_commit}"
            )
        except Exception as e:
            print(f"Could not compare {current_commit} to {run_commit}: {e}")
            return done()
        if comparison["status"] == "ahead":
            print(f"Found newer commit {run_commit} with passing build, updating …")
            return update(args=[run_commit] + args)
        if comparison["status"] in ("behind", "identical"):
            # Candidate is older than what we run; nothing newer exists.
            return done()
        # diverged: not on our history line (force push), try the next run
    print("No newer commit with passing build found.")
    return done()


def update(*, args):
    no_plugins = "--no-plugins" in args
    skip_rebuild = "--skip-rebuild" in args
    args = [arg for arg in args if arg not in ["--no-plugins", "--skip-rebuild"]]
    if len(args) > 1:
        raise Exception("update requires a single argument")
    if len(args) == 0:
        version = "main"
    else:
        version = args[0]
    config = get_config()
    user = config["user"]
    current_venv = config["current"]
    next_venv = [venv for venv in config["venvs"] if venv != current_venv][0]
    cwd = f"/var/lib/{user}"
    path = f"{cwd}/{next_venv}/bin/pip"
    if not no_plugins:
        print("Updating plugins …")
        pull_plugins(config)
    else:
        print("Skipping plugin updates")

    # Apparently, updates from git are currently not guaranteed? I'm not sure what broke, but this fixes it.
    print("Uninstalling old version …")
    subprocess_run(
        [
            path,
            "uninstall",
            "-y",
            "pretalx",
        ],
        check=True,
        cwd=cwd,
    )

    print("Installing new version …")
    subprocess_run(
        [
            path,
            "install",
            "-U",
            "--upgrade-strategy",
            "eager",
            f"git+https://github.com/pretalx/pretalx.git@{version}#egg=pretalx",
            "gunicorn",
            "wheel",
            "django_extensions",
            "ipython",
            "psycopg2-binary",
        ],
        check=True,
        cwd=cwd,
    )
    subprocess_run(
        [
            "cp",
            f"{cwd}/override_settings.py",
            f"{cwd}/{next_venv}/lib/python{PYTHON_VERSION}/site-packages/pretalx/",
        ]
    )
    print("Migrating …")
    pretalx_run(args=["migrate"], env=next_venv, config=config)
    if not skip_rebuild:
        print("Rebuilding static files …")
        pretalx_run(args=["rebuild", "--silent"], env=next_venv, config=config)
    else:
        print("Skipping static file rebuild …")
    print("Stopping old celery worker …")
    systemd_run("stop", f"pretalx-worker@{current_venv}.service")
    systemd_run("disable", f"pretalx-worker@{current_venv}.service")
    print("Starting new celery worker …")
    systemd_run("start", f"pretalx-worker@{next_venv}.service")
    systemd_run("enable", f"pretalx-worker@{next_venv}.service")
    print("Starting new pretalx process …")
    systemd_run("start", f"pretalx@{next_venv}.service")
    systemd_run("start", f"pretalx@{next_venv}.socket")
    systemd_run("enable", f"pretalx@{next_venv}.service")
    systemd_run("enable", f"pretalx@{next_venv}.socket")
    print("Changing caddy config …")
    subprocess_run(
        ["sudo", "sed", "-i", f"s/pretalx_{current_venv}/pretalx_{next_venv}/g", CADDY],
        check=True,
        cwd=cwd,
    )
    print("Reloading caddy …")
    try:
        systemd_run("reload", "caddy", cwd=cwd)
    except Exception:
        # Try a second time, then restart, then give up
        try:
            systemd_run("reload", "caddy", cwd=cwd)
        except Exception:
            systemd_run("restart", "caddy", cwd=cwd)
    print("Stopping old pretalx process …")
    systemd_run("stop", f"pretalx@{current_venv}.service")
    systemd_run("stop", f"pretalx@{current_venv}.socket")
    systemd_run("disable", f"pretalx@{current_venv}.service")
    systemd_run("disable", f"pretalx@{current_venv}.socket")

    config["current"] = next_venv
    config["version"] = version
    save_config(config=config)


def init(*, args):
    config = get_config()
    user = config["user"]
    print("Installing plugins …")
    cwd = f"/var/lib/{user}"
    if "--system" in args:
        for venv in config["venvs"]:
            path = f"{cwd}/{venv}/bin/pip"
            if not Path(path).exists():
                subprocess_run(
                    [
                        "python3",
                        "-m",
                        "venv",
                        venv,
                    ],
                    check=True,
                    cwd=cwd,
                )
            version = "main"
            # run install
            subprocess_run(
                [
                    path,
                    "install",
                    "--upgrade-strategy",
                    "eager",
                    "-U",
                    "gunicorn",
                    "wheel",
                    "psycopg2-binary",
                    "django_extensions",
                    "ipython",
                    f"git+https://github.com/pretalx/pretalx.git@{version}#egg=pretalx",
                ],
                check=True,
                cwd=cwd,
            )
    for plugin in config.get("plugins", []):
        plugin_path = f"{cwd}/plugins/{plugin['name']}"
        if not Path(plugin_path).exists():
            subprocess_run(
                [
                    "git",
                    "clone",
                    plugin["repository"],
                    plugin_path,
                ],
                check=True,
                cwd=cwd,
            )
        for venv in config["venvs"]:
            # install and activate plugins
            path = f"{cwd}/{venv}/bin/pip"
            subprocess_run(
                [
                    path,
                    "install",
                    "--upgrade-strategy",
                    "eager",
                    "-Ue",
                    ".",
                ],
                cwd=plugin_path,
                check=True,
            )


def main():
    if len(sys.argv) == 1:
        print_help()
        sys.exit(-1)

    commands = {
        "status": status,
        "restart": functools.partial(systemd_pretalx, "restart"),
        "start": functools.partial(systemd_pretalx, "start"),
        "stop": functools.partial(systemd_pretalx, "stop"),
        "run": pretalx_run,
        "celery": celery_run,
        "update": update,
        "autoupdate": autoupdate,
        "init": init,
    }

    command = sys.argv[1]
    args = sys.argv[2:]

    if command not in commands:
        print_help()
        sys.exit(-1)

    try:
        commands[command](args=args)
    except subprocess.CalledProcessError as e:
        sys.exit(e.returncode)


if __name__ == "__main__":
    main()
